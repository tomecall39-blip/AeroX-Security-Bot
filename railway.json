{
  "name": "AeroX-Security-Bot",
  "description": "Advanced Discord security bot with slash commands support",
  "keywords": ["discord", "bot", "security", "moderation"],
  "env": {
    "DISCORD_TOKEN": {
      "description": "Your Discord bot token from https://discord.com/developers/applications",
      "required": true
    },
    "MONGODB_URL": {
      "description": "MongoDB connection string",
      "required": true
    }
  },
  "buildCommand": "npm install",
  "startCommand": "node src/index.js",
  "runtime": "node"
}
